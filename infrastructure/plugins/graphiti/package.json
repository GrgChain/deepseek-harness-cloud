{
  "name": "@harness-cloud/dsh-graphiti-memory",
  "version": "0.2.0",
  "description": "Graphiti memory for DSH: bundled skill, MCP tools and managed session archiving and long-term memory extraction.",
  "author": "Harness Cloud",
  "license": "MIT",
  "type": "module",
  "main": "index.mjs",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.mjs",
    "mcp.mjs",
    "session.mjs",
    "skills.mjs",
    "skills",
    "servers",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": "0.2.1-alpha.2"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-alpha.2"
  },
  "scripts": {
    "test": "node --loader ./test-loader.mjs --test test/*.test.mjs",
    "check": "node --check index.mjs && node --check mcp.mjs && node --check session.mjs && node --check skills.mjs && node --check servers/mcp-server.mjs"
  },
  "keywords": [
    "dsh",
    "graphiti",
    "memory",
    "skill",
    "mcp",
    "conversation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jonluo94/deepseek-harness-cloud.git",
    "directory": "infrastructure/plugins/graphiti"
  },
  "homepage": "https://github.com/jonluo94/deepseek-harness-cloud/tree/main/infrastructure/plugins/graphiti"
}
