{
  "name": "@harness-cloud/portal",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --ignore-unknown --ignore-path ../.prettierignore --config ../.prettierrc.json '../**/*.{ts,tsx,js,mjs,cjs,css,html,json,yml,yaml}'",
    "format:check": "prettier --check --ignore-unknown --ignore-path ../.prettierignore --config ../.prettierrc.json '../**/*.{ts,tsx,js,mjs,cjs,css,html,json,yml,yaml}'",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "antd": "^5.0.0",
    "lucide-react": "^0.468.0",
    "officeparser": "^8.1.1",
    "pdfjs-dist": "6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fflate": "^0.8.3",
    "prettier": "3.9.10",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
